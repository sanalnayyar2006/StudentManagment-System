
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User{         //Users table in database will store the credentials and roles of the users
  id              String   @id @default(uuid())
  email           String   @unique
  hashedPassword  String
  role            String?   @default("ADMIN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model School {         //Schools table in database will store the details of the schools
  id                Int       @id@default(autoincrement())
  name              String
  udiseCode         String    @unique
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
}

model Student {        //Students table in database will store the basic details of the students
  id                Int       @id@default(autoincrement())
  schoolId          Int
  admissionNo       String    @unique
  admissionDate     DateTime
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model StudentProfile {     //StudentProfile table in database will store the profile details of the students
  id                Int       @id@default(autoincrement())
  studentId         Int       @unique

  firstName         String
  lastName          String
  dateOfBirth       DateTime

  gender            String?
  bloodGroup        String?
  motherTongue      String?

  fatherName        String
  motherName        String
  guardianName      String?

  primaryMobile     String
  alternateMobile   String?

  email             String?

  address           String
  city              String?
  state             String?
  pincode           String?

  photo             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model StudentClass {     //StudentClass table in database will store the class details of the students
  id                Int       @id@default(autoincrement())
  studentId         Int

  academicYear      String

  className         String
  section           String?
  rollNo            Int?
  stream            String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GovRequiredDetails{     //GovRequiredDetails table in database will store the details of the students that are required by the government
  id                     Int       @id@default(autoincrement())
  studentId              Int       @unique

  aadhaarNumber          String
  aadhaarName            String

  socialCategory         String?
  minorityGroup          String?

  nationality            String?

  bplBeneficiary         Boolean   @default(false)

  antyodayaBeneficiary   Boolean   @default(false)

  disadvantagedGroup     String?

  Out-of-school-Child    Boolean

  cwsn                   Boolean   @default(false)

  disabilityDetails      String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model PreviousAcademicRecord{        //PreviousAcademicRecord table in database will store the previous academic record details of the students
  id                     Int       @id@default(autoincrement())
  studentId              Int       @unique

  previousSchool         String?
  classStudied           String?
  enrolledUnder          String?
  appearedPreviousExam   Boolean?
  result                 String?
  marks                  Float?
  daysAttended           Int?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model ScholarShipDetails{     //ScholarShipDetails table in database will store the scholarship details of the students 
  id                     Int       @id@default(autoincrement())
  studentId              Int

  scholarshipType        String
  scholarshipName        String
  amount                 Float?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model FacilitesProvided {     //FacilitesProvided table in database will store the details of the facilities provided to the students
  id                     Int       @id@default(autoincrement())
  studentId              Int

  freeUniform            Boolean   @default(false)
  freeTextbooks          Boolean   @default(false)
  extraCurricular        String?

  facilityProvidedToCSWN String?
  specificLearningDisability Boolean @default(false)
  TypeofSpecificLearningDisability String?
  AutismSpectrumDisorder Boolean @default(false)
  AttentionDeficitHyperactiveDisorder Boolean @default(false)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
