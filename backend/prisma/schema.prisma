
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User{
  id              String   @id @default(uuid())
  email           String   @unique
  hashedPassword  String
  role            String?   @default("ADMIN")
  name            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model School {
  id                Int       @id@default(autoincrement())
  name              String
  udiseCode         String    @unique
  email             String?
  phone             String?
  address           String?
  city              String?
  state              String?
  pincode           String?
}

model Student {
  id                Int       @id@default(autoincrement())
  schoolId          Int
  admissionNo       String    @unique
  admissionDate     DateTime
  enrollmentDate    DateTime?
  status            String
  attendance        Float?
  session           String?
  feeStatus         String?
  feeOverallStatus  String?
  prescribedFee     String?
  totalPaid         String?
  collectedPercent  Int?
  remaining         String?
  nextDue           String?
  parent            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model StudentProfile {
  id                Int       @id@default(autoincrement())
  studentId         Int       @unique

  firstName         String
  lastName          String
  dateOfBirth       DateTime

  gender            String?
  bloodGroup        String?
  motherTongue      String?
  allergies         String?
  schoolUdise       String?

  fatherName        String
  motherName        String
  guardianName      String?

  primaryMobile     String
  alternateMobile   String?

  email             String?

  address           String
  city              String?
  state              String?
  pincode           String?

  photo             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model StudentClass {
  id                Int       @id@default(autoincrement())
  studentId         Int

  academicYear      String
  className         String
  section           String?
  rollNo            Int?
  stream            String?
  gradeNumber       Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GovRequiredDetails{
  id                     Int       @id@default(autoincrement())
  studentId              Int       @unique

  aadhaarNumber          String
  aadhaarName            String

  socialCategory         String?
  minorityGroup          String?

  nationality            String?
  indianNational         String?

  bplBeneficiary         Boolean   @default(false)

  antyodayaBeneficiary   Boolean   @default(false)

  disadvantagedGroup     String?

  outOfSchoolChild       Boolean   @default(false)

  cwsn                   Boolean   @default(false)

  disabilityDetails      String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model PreviousAcademicRecord{
  id                     Int       @id@default(autoincrement())
  studentId              Int       @unique

  previousSchool         String?
  classStudied           String?
  previousClass          String?
  enrolledUnder          String?
  admittedUnder          String?
  appearedPreviousExam   Boolean?
  appearedForExam        String?
  result                 String?
  previousExamResult     String?
  marks                  Float?
  previousMarksPercent   String?
  daysAttended           Int?
  previousDaysAttended   String?
  previousSchoolingStatus String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model ScholarShipDetails{
  id                     Int       @id@default(autoincrement())
  studentId              Int

  scholarshipType        String
  scholarshipName        String
  amount                 Float?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model FacilitesProvided {
  id                     Int       @id@default(autoincrement())
  studentId              Int

  freeUniform            Boolean   @default(false)
  freeTextbooks          Boolean   @default(false)
  extraCurricular        String?
  facilityProvidedToCSWN String?

  specificLearningDisability          Boolean   @default(false)
  typeofSpecificLearningDisability    String?
  autismSpectrumDisorder              Boolean   @default(false)
  attentionDeficitHyperactiveDisorder Boolean   @default(false)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
